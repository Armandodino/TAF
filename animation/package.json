{
  "name": "ayoka-animation",
  "version": "1.0.0",
  "private": true,
  "description": "Animations de marque du logo AYOKA, en Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render AyokaSquare out/ayoka-1080.mp4",
    "render:reel": "remotion render AyokaReel out/ayoka-reel.mp4",
    "render:banner": "remotion render AyokaBanner out/ayoka-banner.mp4",
    "render:film": "remotion render AyokaFilm out/ayoka-pub-16x9.mp4",
    "render:film:vertical": "remotion render AyokaFilmVertical out/ayoka-pub-9x16.mp4",
    "media": "node tools/scan-media.mjs",
    "render:gif": "remotion render AyokaSquare out/ayoka.gif --codec=gif",
    "still": "remotion still AyokaSquare out/ayoka-final.png --frame=115"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/fonts": "^4.0.528",
    "@remotion/google-fonts": "^4.0.528",
    "@remotion/transitions": "^4.0.528",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
