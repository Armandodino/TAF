{
  "name": "ayoka-animation",
  "version": "1.0.0",
  "private": true,
  "description": "Animations de marque du logo AYOKA, en Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render AyokaReveal out/ayoka-1080.mp4",
    "render:reel": "remotion render AyokaReel out/ayoka-reel.mp4",
    "render:gif": "remotion render AyokaReveal out/ayoka.gif --codec=gif",
    "still": "remotion still AyokaReveal out/ayoka-final.png --frame=170"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
